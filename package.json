    "db:seed-board-demo": "tsx --conditions=react-server scripts/seed-board-demo.ts",
    "db:seed-conversations-demo": "tsx --conditions=react-server scripts/seed-conversations-demo.ts",
    "db:apply-conversations-migration": "tsx scripts/apply-migration-0015-conversations.ts",
