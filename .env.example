# Copy to `.env.local` and fill in real values. Never commit secrets.
# Generate SESSION_SECRET: openssl rand -base64 32

# Required — Neon database `sponsoro-crm` (not compliance `neondb`). Pooled URL for `crm_app`.
# neon connection-string production --database-name sponsoro-crm --role-name crm_app --pooled
DATABASE_URL=postgresql://crm_app:REPLACE@ep-xxx.eu-west-2.aws.neon.tech/sponsoro-crm?sslmode=require

# Optional — Postgres URL for Vitest integration tests (`*.int.test.ts`). Use the same `crm_app` role
# as production (RLS enforced). When unset, integration tests are skipped.
# TEST_DATABASE_URL=postgresql://crm_app:REPLACE@ep-xxx.eu-west-2.aws.neon.tech/sponsoro-crm?sslmode=require

# Migrations only (`pnpm db:migrate`) — direct (non-pooler) URL. Optional: falls back to DATABASE_URL.
# Bootstrap: same as owner on sponsoro-crm. Later: crm_migrator role.
# DATABASE_MIGRATION_URL=postgresql://crm_migrator:REPLACE@ep-xxx.eu-west-2.aws.neon.tech/sponsoro-crm?sslmode=require

# Optional — Postgres connections per Node process (default 5). With ~500 concurrent users,
# use the Neon *pooler* DATABASE_URL and keep this low (3–5) so instances share the pool safely.
# DATABASE_POOL_MAX=5

# Required — session signing / cookie security baseline (min 32 characters)
SESSION_SECRET=replace-with-at-least-32-characters-secret

# Application
APP_ENV=local
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Compliance app link in the header switcher
NEXT_PUBLIC_COMPLIANCE_APP_URL=https://app.sponsoro.co.uk
COMPLIANCE_APP_URL=https://app.sponsoro.co.uk

# Local HTTP only (Playwright / next start over http)
# ALLOW_INSECURE_SESSION_COOKIES=true

# Playwright (contacts E2E) — admin user in your dev org; never use production credentials.
# PLAYWRIGHT_E2E=1 is set automatically by playwright.config.ts.
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=your-dev-password
# PLAYWRIGHT_SKIP_WEBSERVER=1  # reuse `pnpm dev` on E2E_PORT (default 3000)
# E2E_PORT=3000

# Optional — Cloudflare Turnstile (all three or none)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_HOSTNAMES=localhost,crm.sponsoro.co.uk

# Optional — Google SSO (both or none). Redirect URI: {APP_BASE_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional — Microsoft SSO (all three or none). Redirect URI: {APP_BASE_URL}/api/auth/microsoft/callback
# MICROSOFT_SSO_CLIENT_ID=
# MICROSOFT_SSO_CLIENT_SECRET=
# MICROSOFT_SSO_TENANT_ID=common

# Contact & invite email sends through Google Mail (Gmail API) after OAuth connect in-app.
# Requires GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above and redirect URI:
#   {APP_BASE_URL}/api/integrations/google_mail/callback

# Optional — AI reply drafts when a contact responds to outreach (falls back to a template if unset)
# OPENAI_API_KEY=

# Optional — Channels (WhatsApp managed scaffold; use with CHANNELS_USE_FAKE=1 locally)
# CHANNELS_MANAGED_WHATSAPP=1
# CHANNELS_USE_FAKE=1
# TWILIO_ACCOUNT_SID=
# TWILIO_ISV_EMBEDDED_SIGNUP_CONFIG_ID=
# META_WHATSAPP_VERIFY_TOKEN=

# Optional — Stripe Connect OAuth for payments integration
# STRIPE_CONNECT_CLIENT_ID=
# STRIPE_SECRET_KEY=
